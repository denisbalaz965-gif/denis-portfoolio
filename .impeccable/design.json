  "narrative": {
    "northStar": "Na konci internetu",
    "overview": "“Na konci internetu” is one phosphor-green world experienced through a compact WebGL camera flight. Abstract crystalline data shards carry the six projects. A single primary project is legible at a time; smaller surrounding fragments establish depth. Green procedural fog, a faint vertical axis and sparse debris connect the introduction, projects and contact.\n\nThe project preview is an HTML hologram anchored beside the projected geometry. Revealing it freezes the world so the visitor can read and choose the article link. The article then opens as a calm inset surface over the same background. Client screenshots belong to the detailed evidence inside articles, not to the main flight's shard surfaces.",
    "keyCharacteristics": [
      "One green WebGL atmosphere with procedural fog and crystalline data shards.",
      "A primary project surrounded by smaller fragments in depth.",
      "Projected native HTML buttons and a separate readable hologram reveal.",
      "A frozen world while a hologram or article is open.",
      "Square controls, self-hosted Instrument Sans and a fine-pointer target cursor.",
      "Native HTML project summaries and links when WebGL is unavailable."
    ],
    "rules": [
      {
        "name": "The Continuous World Rule",
        "body": "Keep the flight, hologram and article within one green atmosphere; preserve the world behind the reading surface.",
        "section": "colors"
      },
      {
        "name": "The Reading Lock Rule",
        "body": "Freeze autonomous world motion and camera interpolation while a hologram or article is open. Resume travel when reading closes or the visitor scrolls onward.",
        "section": "elevation"
      },
      {
        "name": "The HTML Evidence Rule",
        "body": "Keep project names, summaries, article links, states and evidence in semantic HTML independently of the WebGL geometry.",
        "section": "typography"
      }
    ],
    "dos": [
      "**Do** keep one primary project and use smaller distant shards to establish depth.",
      "**Do** reveal the HTML hologram on mouse hover, keyboard focus or first tap before the story link opens the article.",
      "**Do** preserve a generous invisible hit area and a continuous pointer bridge to the panel.",
      "**Do** keep native links available when WebGL fails or loses its context.",
      "**Do** preserve the exact saved flight scroll position when the article closes."
    ],
    "donts": [
      "**Don't** place client-image previews or CSS-tinted screenshot cards in the main flight.",
      "**Don't** turn the abstract crystalline data shards into literal meteorites.",
      "**Don't** move the camera or ambient world while a hologram is being read.",
      "**Don't** show the custom mouse cursor on coarse-pointer mobile devices.",
      "**Don't** imply that pause disables scrolling or all article animation."
    ]
