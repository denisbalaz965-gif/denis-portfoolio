  "narrative": {
    "northStar": "Na konci internetu",
    "overview": "“Na konci internetu” is the owner-confirmed replacement world: one continuous phosphor-green space with a persistent vertical axis, sparse geometric data planes and six ordered fragments that approach and depart as the visitor scrolls. The background remains present from the opening sentence through the project archive and contact.\n\nDepth comes from perspective, scale, sparse linework and controlled glow. The fragments are pieces of a digital archive, not literal meteorites or a collection of separate card sections. Opening a project places a calmer reading surface over the same world; it does not replace that world with a different page identity.",
    "keyCharacteristics": [
      "A fixed green field and vertical axis persist through the whole journey.",
      "Six project fragments alternate their desktop alignment and move through scroll-owned depth.",
      "Large Instrument Sans headings pair with small monospace coordinates and category text.",
      "Clipped planes, square controls and restrained phosphor glow replace rounded gallery cards.",
      "An inset article surface preserves the surrounding space and factual project evidence."
    ],
    "rules": [
      {
        "name": "The Continuous World Rule",
        "body": "Keep the field and axis present across intro, project fragments, personal text and contact; do not introduce unrelated section backgrounds.",
        "section": "colors"
      },
      {
        "name": "The Reading Interval Rule",
        "body": "Give each approaching fragment a stable, fully visible reading interval before it departs.",
        "section": "elevation"
      },
      {
        "name": "The Evidence Rule",
        "body": "Keep project status, Denis’s contribution and source captions readable inside the article; atmospheric treatment must not strengthen the underlying claims.",
        "section": "typography"
      }
    ],
    "dos": [
      "**Do** preserve one continuous background and the ordered six-project sequence.",
      "**Do** keep the small index, readable titles, visible focus outlines and explicit close control.",
      "**Do** treat horizontal gestures as project switching and vertical gestures as article reading.",
      "**Do** preserve the saved journey scroll position when the article closes.",
      "**Do** distinguish presentation filters, illustrations, model data and authentic captures in the project evidence."
    ],
    "donts": [
      "**Don't** describe the geometric planes as literal meteorites or add unrelated space imagery.",
      "**Don't** rebuild the former separate web/grant galleries or rounded navigation pill.",
      "**Don't** make pause imply that all scroll-linked movement stops.",
      "**Don't** promote grant approval or a contractual funding limit into payment or completed delivery."
    ]
  }
}
